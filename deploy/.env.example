# div:ide environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# Lines starting with '#' are comments — keep them on their own line, since
# Docker Compose does NOT support inline comments after values.

# General
DIVIDE_ENV=dev                  # dev | staging | production
DIVIDE_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
DIVIDE_DOMAIN=divide.local      # FQDN used by Traefik + ACME

# Postgres
POSTGRES_PASSWORD=changeme      # set a strong random password

# MinIO / S3
MINIO_ROOT_USER=divide
MINIO_ROOT_PASSWORD=changeme    # 16+ chars for production
MINIO_BUCKET=divide-artifacts

# TLS / ACME (set ACME_EMAIL for Let's Encrypt in staging/production)
ACME_EMAIL=admin@divide.local

# Proxmox
#
# NOTE: as of F-pve-config-ui these env vars are the FALLBACK path.
# The default onboarding flow is the portal wizard's PveCredentialsStep
# (it stores the connection in the pve_config DB row, which takes
# precedence over the env-var fallback). Set these only if you want to
# bootstrap with env-var-driven config and skip the wizard, or if you're
# scripting the deploy. See docs/PROXMOX-SETUP.md §5-6.
#
# PROXMOX_HOST=https://pve.example.com
PROXMOX_PORT=8006
PROXMOX_USER=divide@pve@pam
# PROXMOX_TOKEN_ID=drill-token
# NOTE: PROXMOX_TOKEN_ID is the FULL "<user>!<token-name>" string, e.g. "divide@pve@pam!drill-token"
# PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
PROXMOX_VERIFY_SSL=true         # set false only for self-signed dev PVE

# --- F-pve-bridge-wizard (PVE bridge provisioning) ---
# The first-time wizard's Step 0 SSHes into PVE to add the F3
# vmbrN bridges. Default credentials for the SSH leg:
#
#   DIVIDE_PVE_SSH_USER=root       (override only if your PVE
#                                    root user is named differently
#                                    or you have a sudoer account)
#   DIVIDE_PVE_SSH_KEY=            (path on the API container's
#                                    filesystem; paste via the
#                                    wizard's UI to override)
#
# The wizard prompts for the SSH host, user, and key/password at
# runtime, so these env vars are only needed if you want to
# drive `make pve-setup-bridges` non-interactively.
DIVIDE_PVE_SSH_USER=root
DIVIDE_PVE_NODE=pve

# Scenario catalog (mounted into the api container by docker-compose.yml).
# Set DIVIDE_SYNC_ON_STARTUP=false to disable auto-sync at API boot.
DIVIDE_SCENARIOS_DIR=/workdir/examples/scenarios
DIVIDE_SYNC_ON_STARTUP=true
DIVIDE_REPO_ROOT=..              # repo root mounted at /workdir in the container

# Observability (Prometheus + Grafana)
# Both are exposed on localhost only (ports 9090 + 3000) for dev. In
# production, gate them with an authenticating reverse proxy. The
# defaults below match docker-compose.yml; override here.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme    # change for anything past local dev

# --- F3-prep credential login ----------------------------------------
# Set BOTH vars to bootstrap the first admin user on API startup.
# Empty defaults = no auto-admin. After the first admin exists, remove
# both vars from your .env file (they become no-ops).
#
# WARNING: setting these in production creates a known admin account.
# Change the password immediately after first login. The bootstrap is
# intentionally loud — the API logs "divide_api.bootstrap_admin.created"
# on success.
#
# See docs/USERS.md for the full operator guide.
DIVIDE_BOOTSTRAP_ADMIN_SUB=
DIVIDE_BOOTSTRAP_ADMIN_PASSWORD=

# Token TTL for /api/v1/auth/login, in seconds. Default 8h (28800).
# Shorter for high-security; longer for hands-off demo boxes.
DIVIDE_LOGIN_TOKEN_TTL_S=28800

# --- WireGuard VPN -----------------------------------------------------------
# WG_HOST: public IP or hostname trainees use to connect. REQUIRED.
# Example: WG_HOST=203.0.113.42  or  WG_HOST=range.example.com
WG_HOST=

# WG_PASSWORD_HASH: bcrypt hash of the wg-easy admin UI password.
# Generate with: docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'YourPassword'
WG_PASSWORD_HASH=

# DIVIDE_WG_PEER_SECRET: random secret used to derive per-user keypairs.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# WARNING: changing this invalidates all existing VPN configs.
DIVIDE_WG_PEER_SECRET=change-me-generate-with-secrets-token-hex-32

# VPN subnet (clients get IPs from this pool; server takes .1).
DIVIDE_WG_SUBNET=10.13.37.0/24

# Routes pushed to the client (only drill VMs + VPN pool by default).
DIVIDE_WG_ALLOWED_IPS=10.10.0.0/16, 10.13.37.0/24

# DNS server pushed to the client.
DIVIDE_WG_DNS=1.1.1.1

# WireGuard UDP port (must match the port opened on your firewall).
DIVIDE_WG_PORT=51820
WG_PORT=51820
